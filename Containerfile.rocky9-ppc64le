# ---------------------------------------------------------------------------
# Containerfile.rocky9-ppc64le
#
# Runs the full test suite for libs/context inside a Rocky Linux 9 ppc64le
# container, replicating the upstream CI recipe exactly
# (.github/workflows/ci.yml):
#
#   1. Clone boostorg/boost superproject (boost-1.87.0 branch)
#   2. Init tools/build, libs/config, tools/boostdep submodules
#   3. cp -r this entire repo into libs/context
#   4. depinst.py context  — fetches all transitive library deps
#   5. ./bootstrap.sh && ./b2 headers
#   6. b2 libs/context/test toolset=gcc cxxstd=14
#
# Build & run (from repo root):
#   podman build --platform linux/ppc64le \
#       -f Containerfile.rocky9-ppc64le \
#       -t boost-ctx-test:rocky9 .
#
# A non-zero test exit fails the build — result is immediately visible.
# ---------------------------------------------------------------------------

FROM --platform=linux/ppc64le rockylinux:9

LABEL description="boost.context ppc64le test suite (b2, CI recipe) — Rocky Linux 9"

# ── system packages ──────────────────────────────────────────────────────────
# gcc gcc-c++   : assembler + C++ compiler (GCC 11 on Rocky 9)
# python3       : required by depinst.py
# git           : clone boostorg/boost superproject
# which         : required by bootstrap.sh
RUN dnf install -y \
        gcc \
        gcc-c++ \
        python3 \
        git \
        which \
        && dnf clean all

# ── copy this repo (will be overlaid into libs/context below) ─────────────────
COPY . /context-repo

# ── replicate CI: clone superproject, overlay repo, depinst, build, test ──────
RUN git clone --depth 1 --branch boost-1.87.0 \
        https://github.com/boostorg/boost.git /boost-root \
    && cd /boost-root \
    && git submodule update --init tools/build \
    && git submodule update --init libs/config \
    && git submodule update --init tools/boostdep \
    && cp -r /context-repo/. libs/context \
    && python3 tools/boostdep/depinst/depinst.py context \
    && ./bootstrap.sh \
    && ./b2 headers \
    && echo "using gcc ;" > /root/user-config.jam \
    && ./b2 -j$(nproc) libs/context/test toolset=gcc cxxstd=14
